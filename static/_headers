# Cloudflare Pages cache policy. Hashed and immutable things get a year.
# Matching rules join duplicate header values with commas. Use
# ! Cache-Control before a specific policy to detach the broader value.

# Every page: HTTPS only from the first visit on, and never framed by another
# site, so a hidden frame can't click Delete account in Settings. Subdomains
# are left out of HSTS until each is known to serve HTTPS alone.
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-QUMDXc2T8El/3wP0uUFa1E+/ba1el1zBEtwOUk4+5Hk=' 'sha256-LseA4eeqkInM1lz93tn4qEimtMee7c6WSt7yeGqYoCQ=' https://clerk.ciphermaniac.com https://challenges.cloudflare.com https://*.protect.clerk.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://r2.ciphermaniac.com https://events-data.ciphermaniac.com https://clerk.ciphermaniac.com https://*.protect.clerk.com https://clerk-telemetry.com https://*.clerk-telemetry.com; frame-src https://challenges.cloudflare.com https://*.protect.clerk.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN

# Account and organizer pages stay out of search. /host itself is the
# public landing page; /host/* is each event's console.
/settings
  X-Robots-Tag: noindex
/account
  X-Robots-Tag: noindex
/welcome
  X-Robots-Tag: noindex
/history
  X-Robots-Tag: noindex
/apply
  X-Robots-Tag: noindex
/admin
  X-Robots-Tag: noindex
/host/*
  X-Robots-Tag: noindex
/stores/join
  X-Robots-Tag: noindex
/stores/:id/settings
  X-Robots-Tag: noindex

# Vite bundles: content-hashed filenames, safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted Inter woff2 (P1.2): versionless filenames but the files are
# effectively frozen; if we ever swap fonts we'll rename them.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
