{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "site",
  "description": "The live site in the main window may call the TOM bridge and tell the app its mode, and nothing else.",
  "windows": [
    "main"
  ],
  "local": false,
  "remote": {
    "urls": [
      "https://events.ciphermaniac.com/*"
    ]
  },
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "permissions": [
    "tom-bridge",
    "app-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
