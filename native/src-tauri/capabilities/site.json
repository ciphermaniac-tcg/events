{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "site",
  "description": "The live site in the main window may call the TOM bridge, tell the app its mode and open an event's big screen, and nothing else.",
  "windows": [
    "main"
  ],
  "local": false,
  "remote": {
    "urls": [
      "https://events.ciphermaniac.com/*"
    ]
  },
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "permissions": [
    "tom-bridge",
    "app-theme",
    "big-screen"
  ]
}
