<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material's own components, its pickers among them (Pickers.kt), take
         the site's colours (DESIGN.md), not Material's baseline purple. -->
    <style name="Theme.ciphermaniac_events" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_fill</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_fill</item>
        <item name="colorSecondary">@color/muted</item>
        <item name="colorSecondaryContainer">@color/surface_2</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_2</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/rule</item>
    </style>

    <!-- Shown from launch until the first page shows content (MainActivity). -->
    <style name="Theme.ciphermaniac_events.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <!-- The launcher icon itself, so the glow behind the mark shows too. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.ciphermaniac_events</item>
    </style>
</resources>
