{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ciphermaniac Events",
  "version": "0.1.0",
  "identifier": "com.ciphermaniac.events",
  "build": {
    "frontendDist": "../panel/dist",
    "devUrl": "http://127.0.0.1:4420",
    "beforeDevCommand": "npm run dev:panel",
    "beforeBuildCommand": "npm run build:panel && npm run build:bridge"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ciphermaniac Events",
        "url": "https://events.ciphermaniac.com",
        "width": 1280,
        "height": 860,
        "minWidth": 390,
        "minHeight": 600,
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFNTJGQ0VGRkY4MkU5RTcKUldUbjZZTC83L3hTZm5qNEZ1VFArV3Q2MENyR2xPb0dkdWlEcitZVnl6WlA3Sm1tUzlHQkJzM3YK",
      "endpoints": [
        "https://github.com/ciphermaniac-tcg/events/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
